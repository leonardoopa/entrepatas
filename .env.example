# Copie para .env e ajuste: cp .env.example .env
# Obrigatório em produção (o padrão entrepatas-dev serve só para desenvolvimento):
POSTGRES_PASSWORD=troque-esta-senha

# Backoffice: URL da API e chave (crie com: docker compose exec web python manage.py criar_chave_api site-producao site, no projeto do backoffice)
BACKOFFICE_URL=http://host.docker.internal:8500/api/v1
BACKOFFICE_API_KEY=cole-a-chave-aqui

# Porta do site no seu computador (http://localhost:8431)
WEB_PORT=8431

# --- Produção / staging (docker compose -f docker-compose.yml up -d --build) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# DJANGO_ALLOWED_HOSTS=www.entrepatas.com,entrepatas.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.entrepatas.com,https://entrepatas.com
# DJANGO_HTTPS=1                # atrás de proxy com HTTPS: cookies seguros

DJANGO_LOG_LEVEL=INFO

# --- E-mail (recuperação de senha). Sem DJANGO_EMAIL_HOST, os e-mails aparecem em: docker compose logs web ---
# DJANGO_EMAIL_HOST=smtp.seuprovedor.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=usuario
# DJANGO_EMAIL_PASSWORD=senha
# DJANGO_DEFAULT_FROM_EMAIL=EntrePatas <contato@entrepatas.com>
